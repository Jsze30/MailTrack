{
  "manifest_version": 3,
  "name": "MailTrack",
  "version": "2.0.38",
  "description": "Track new emails and replies, then show opened status in Gmail.",
  "key": "",
  "permissions": ["storage"],
  "host_permissions": ["https://*/*", "http://localhost/*"],
  "content_scripts": [
    {
      "matches": ["https://mail.google.com/*"],
      "js": ["src/send-gate.js"],
      "run_at": "document_start"
    },
    {
      "matches": ["https://mail.google.com/*"],
      "js": ["src/gmail-page.js"],
      "run_at": "document_start",
      "world": "MAIN"
    },
    {
      "matches": ["https://mail.google.com/*"],
      "js": ["src/mt-core.js", "src/schedule-time.js", "src/content.js", "src/mt-ui.js"],
      "css": ["src/content.css"],
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "MailTrack"
  }
}
